<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="crm_dashboard.CrmDashboard">
        <div style="height:900px; overflow-y:scroll">
            <div>
                <center>
                    <h1 style="font-size: 50px; font-weight: bold; color: #374151; margin-bottom: 28px;">CRM Dashboard
                    </h1>
                </center>
            </div>
            <div class="ms-lg-2" style="padding-left:200px;">
                <span class="small me-1 navbar-text" style="font-size: 14px; font-weight: bold">Filter By:</span>
                <select class="o_input" style="width:100px; padding:20px" t-model="this.state.selecteddate" t-on-change="() => this.getDate()">
                    <option>Year</option>
                    <option>Quarter</option>
                    <option>Month</option>
                    <option>Week</option>
                </select>
            </div>
            <div class="row main-section" style="margin-left: 120px; padding-right:90px">
                <!-- Lead Tile-->
                <div id="leads" class="col-md-4 col-sm-6 tot_tasks oh-payslip"
                     style=" overflow: hidden; padding-top: 30px;">
                    <div class="oh-card" style="box-shadow:2px 4px 8px 2px rgba(0,0,0.3,0.2);
       display: flex; justify-content: center;">
                        <div class="oh-card-body"
                             style="padding: 5px 5px; float: left; width: 100%;
                 height: auto; box-sizing: border-box; margin: 0;">
                            <div class="stat-widget-one">
                                <div class="stat-icon bg-mauve-light d-flex justify-content-left align-items-left">
                                    <div style="background:#ff4d94; width:65px; text-align: center;">
                                        <i class="fa fa-tasks text-mauve"
                                           style="font-size:50px;"/>
                                    </div>
                                    <div class="stat_content" style="
                         text-align: center; font-weight: bold;
                         padding-top: 20px; padding-left: 80px;">
                                        <div class="stat_count_lead"
                                             style="font-size: 17px;">
                                            <span id="templates">
                                                <div id="my_lead"/>
                                            </span>
                                        </div>
                                        <div class="stat-head"
                                             style="font-size: 14px;">My Leads
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Opportunity Tile-->
                <div id="opportunity" class="col-md-4 col-sm-6 tot_tasks oh-payslip"
                     style=" overflow: hidden; padding-top: 30px;">
                    <div class="oh-card" style="box-shadow:2px 4px 8px 2px rgba(0,0,0.3,0.2);
       display: flex; justify-content: center;" role="button">
                        <div class="oh-card-body"
                             style="padding: 5px 5px; float: left; width: 100%;
                 height: auto; box-sizing: border-box; margin: 0;">
                            <div class="stat-widget-one">
                                <div class="stat-icon bg-mauve-light d-flex justify-content-left align-items-left">
                                    <div style="background:yellow; width:65px; text-align: center;">
                                        <i class="fa fa-trophy  text-mauve"
                                           style="font-size:50px;"/>
                                    </div>
                                    <div class="stat-content" style="
                         text-align: center; font-weight: bold;
                         padding-top: 20px; padding-left: 80px;">
                                        <div class="stat_count_opp"
                                             style="font-size: 17px;">
                                            <span id="templates">
                                                <div id="my_opportunity"/>
                                            </span>
                                        </div>
                                        <div class="stat-head"
                                             style="font-size: 14px;">My Opportunity
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Expected Revenue -->
                <div id="exp_revenue"
                     class="col-md-4 col-sm-6 tot_tasks oh-payslip"
                     style="overflow: hidden; padding-top: 30px;">
                    <div class="oh-card" style="box-shadow:2px 4px 8px 2px rgba(0,0,0.3,0.2);
       display: flex; justify-content: center;">
                        <div class="oh-card-body"
                             style="padding: 5px 5px; float: left; width: 100%;
                 height: auto; box-sizing: border-box; margin: 0;">
                            <div class="stat-widget-one">
                                <div class="stat-icon bg-mauve-light d-flex justify-content-left align-items-left">
                                    <div style="background:#bf80ff;; width:65px; text-align: center;">
                                        <i class="fa fa-usd  text-mauve"
                                           style="font-size:50px;"/>
                                    </div>
                                    <div class="stat-content" style="
                         text-align: center; font-weight: bold;
                         padding-top: 20px; padding-left: 80px;">
                                        <div class="stat_count_ex_rev"
                                             style="font-size: 17px;">
                                            <span id="templates">
                                                <div id="expected_revenue"/>
                                            </span>
                                        </div>
                                        <div class="stat-head"
                                             style="font-size: 14px;">Expected
                                            revenue
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Revenue -->
                <div id="tot_revenue"
                     class="col-md-4 col-sm-6 tot_tasks oh-payslip"
                     style=" overflow: hidden; padding-top: 30px;">
                    <div class="oh-card" style="box-shadow:2px 4px 8px 2px rgba(0,0,0.3,0.2);
       display: flex; justify-content: center;">
                        <div class="oh-card-body"
                             style="padding: 5px 5px; float: left; width: 100%;
                 height: auto; box-sizing: border-box; margin: 0;">
                            <div class="stat-widget-one">
                                <div class="stat-icon bg-mauve-light d-flex justify-content-left align-items-left">
                                    <div style="background:#bf80ff;; width:65px; text-align: center;">
                                        <i class="fa fa-usd  text-mauve"
                                           style="font-size:50px;"/>
                                    </div>
                                    <div class="stat-content" style="
                         text-align: center; font-weight: bold;
                         padding-top: 20px; padding-left: 80px;">
                                        <div class="stat_count_ex_rev"
                                             style="font-size: 17px;">
                                            <span id="templates">
                                                <div id="total_revenue"/>
                                            </span>
                                        </div>
                                        <div class="stat-head"
                                             style="font-size: 14px;">Revenue
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Win Ratio-->
                <div id="win ratio" class="col-md-4 col-sm-6 tot_tasks oh-payslip"
                     style=" overflow: hidden; padding-top: 30px;">
                    <div class="oh-card" style="box-shadow:2px 4px 8px 2px rgba(0,0,0.3,0.2);
       display: flex; justify-content: center;">
                        <div class="oh-card-body"
                             style="padding: 5px 5px; float: left; width: 100%;
                 height: auto; box-sizing: border-box; margin: 0;">
                            <div class="stat-widget-one">
                                <div class="stat-icon bg-mauve-light d-flex justify-content-left align-items-left">
                                    <div style="background:yellow; width:65px; text-align: center;">
                                        <i class="fa fa-trophy  text-mauve"
                                           style="font-size:50px;"/>
                                    </div>
                                    <div class="stat-content" style="
                         text-align: center; font-weight: bold;
                         padding-top: 20px; padding-left: 80px;">
                                        <div class="stat_count_opp"
                                             style="font-size: 17px;">
                                            <span id="templates">
                                                <div id="win_ratio"/>
                                            </span>
                                        </div>
                                        <div class="stat-head"
                                             style="font-size: 14px;">Win Ratio
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mt-4" style="padding-top:70px; padding-left:200px;">
                <div class="col-md-6">
                    <div class="oh-card" style="box-shadow:2px 4px 8px 2px rgba(0,0,0.3,0.2);
       display: flex; justify-content: center; width:600px; height:600px;">
                        <div style="width:550px; height:550px;">
                            <span style="font-size: 15px; padding-left:200px;">Activity Pie Chart</span>
                            <canvas id="activity_pie_chart"/>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="oh-card" style="box-shadow:2px 4px 8px 2px rgba(0,0,0.3,0.2);
       display: flex; justify-content: center; width:600px; height:600px;">
                        <div style="width:700px; height:700px;">
                            <span style="font-size: 15px; padding-left:240px;">Lost Leads</span>
                            <canvas id="lost_lead_graph" style="padding-top:70px;"/>
                        </div>
                    </div>
                </div>
                <div class="col-md-6" style="padding-top:70px;">
                    <div class="oh-card" style="box-shadow:2px 4px 8px 2px rgba(0,0,0.3,0.2);
           display: flex; justify-content: center; width:600px; height:600px;">
                        <div style="width:700px; height:700px;">
                            <span style="font-size: 15px; padding-left:210px;">Leads By Campaign</span>
                            <canvas id="campaign_lead_graph" style="padding-top:70px;"/>
                        </div>
                    </div>
                </div>
                <div class="col-md-6" style="padding-top:70px;">
                    <div class="oh-card" style="box-shadow:2px 4px 8px 2px rgba(0,0,0.3,0.2);
           display: flex; justify-content: center; width:600px; height:600px;">
                        <div style="width:550px; height:550px;">
                            <span style="font-size: 15px; padding-left:210px;">Leads By Medium</span>
                            <canvas id="medium_lead_graph"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
